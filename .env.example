# Environment Variables
# Copy this file to .env and fill in the values

# --- Core ---

# development | testing | production
FLASK_ENV=development
FLASK_DEBUG=false

# PostgreSQL connection URL (matches the db service in docker-compose.yml)
DATABASE_URL=postgresql://construction:construction@localhost:5432/construction

# Flask session signing key. Production refuses to boot while it is empty or still contains
# "dev-", so this placeholder cannot ship by accident; set a long random value in production.
SECRET_KEY=dev-secret-key-change-me

# JWT signing key. Production refuses to boot while it is empty or still contains "dev-".
JWT_SECRET_KEY=dev-jwt-secret-change-me

# Redis: rate limits, the sign-out token blocklist, and the assistant's queue and limits
REDIS_URL=redis://localhost:6379/0

# Comma-separated origins allowed to call the API with credentials (browser CORS)
CORS_ORIGINS=http://localhost:3000

# How many reverse proxies sit in front of the API and may name the caller through
# X-Forwarded-For. Rate limits are keyed on that address, so behind a proxy 0 makes the
# whole deployment share one bucket. 0 = trust nothing (default); 1 behind a single
# reverse proxy or tunnel.
TRUSTED_PROXY_HOPS=0

# Refresh-token lifetime for every sign-in: "expiring" (7 days) or "persistent" (never
# expires; the session lasts until sign-out).
REFRESH_TOKEN_POLICY=expiring

# Relaxes JWT cookie security (Secure=False, SameSite=None, no CSRF) for local HTTP-only
# development. Only allowed when FLASK_ENV is development (or unset); with any other
# FLASK_ENV the app refuses to boot. Leave unset/0 unless you are testing over plain HTTP.
FLASK_DEV_INSECURE=0

# Serves the OpenAPI spec (/openapi.json) and Swagger UI (/v1/documentation). Always on
# unless FLASK_ENV=production; set to 1 to serve them in production too.
EXPOSE_DOCS=0

# --- Storage (S3 / MinIO) — every uploaded file (attachments, documents, photos/videos,
# chat, library and chiffrage images, analyses, assistant scans) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=construction-attachments
S3_REGION=us-east-1
# Public-facing S3/MinIO URL for browser-direct presigned uploads. Empty = disabled; the
# frontend falls back to a multipart POST upload through the API.
S3_PUBLIC_ENDPOINT_URL=

# Optional per-upload size caps (bytes). Defaults shown; only set to override them.
# Multipart uploads stop at 151 MiB whatever these say; larger files need presigned
# uploads (S3_PUBLIC_ENDPOINT_URL).
# PROJECT_DOCUMENT_MAX_SIZE_BYTES=157286400
# PROJECT_PHOTO_MAX_SIZE_BYTES=26214400
# PROJECT_VIDEO_MAX_SIZE_BYTES=52428800

# How many days back a worker may still log their own attendance (default 31).
# SELF_ATTENDANCE_MAX_BACKDATE_DAYS=31

# --- Email (invitations, "added to project" notices) ---
# EMAIL_PROVIDER options: resend | inmemory (tests). Any other value, including the unset
# default "smtp", wires no email adapter: invitations are created but their emails are skipped.
EMAIL_PROVIDER=resend
# Resend settings (used when EMAIL_PROVIDER=resend; the API will not start if either is empty)
RESEND_API_KEY=re_xxx_replace_me
FROM_EMAIL=invites@yourdomain.com
# Base URL of the frontend app, used to build links in invitation emails
APP_BASE_URL=http://localhost:3000

# --- Sign-in: French phone number + SMS code (the only sign-in method) ---
# SMS_PROVIDER options: log (writes the code to the API log, dev) | twilio | gateway
SMS_PROVIDER=log
# Twilio settings (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=Folio
# "SMS Gateway for Android" settings (used when SMS_PROVIDER=gateway) — HTTP Basic auth
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Sign-in code lifetime/throttle. Defaults shown; only set to override them.
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=60
# OTP_HOURLY_MAX=5
# OTP_MAX_ATTEMPTS=5
# Test-only bypass code (6 digits) accepted in place of the real SMS code. Only honoured
# when FLASK_ENV is explicitly development or testing. MUST stay unset in production.
OTP_TEST_CODE=
# App Store / Play review account: set BOTH or neither. See README.md for the full rule.
OTP_REVIEWER_PHONE=
OTP_REVIEWER_CODE=

# --- Push notifications (chat, tasks, membership, attendance, billing events) ---
# PUSH_PROVIDER options: log (writes to the API log, dev) | expo
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
# Locale for push copy: vi | fr | en
PUSH_LOCALE=vi

# --- Optional features (off by default) ---
FEATURE_CHAT=0
# The assistant lives in team chat: it also needs FEATURE_CHAT=1.
FEATURE_ASSISTANT=0

# --- Folio Assistant (ignored unless FEATURE_ASSISTANT=1; live only once DEEPSEEK_API_KEY
# and TYPESAFE_API_KEY are both set) ---
DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# SCAN_MODE options: genai (default) | opencv
SCAN_MODE=genai
ASSISTANT_DAILY_COST_CAP_USD=5

# --- ai-browser container only (Dockerfile.browser) — not read by this app process ---
# It also needs DATABASE_URL, REDIS_URL, S3_*, FEATURE_ASSISTANT, DEEPSEEK_API_KEY and
# ASSISTANT_DAILY_COST_CAP_USD from above.
# Set to 1 when the web process has TYPESAFE_API_KEY (the container never receives the key itself).
TYPESAFE_API_KEY_CONFIGURED=
# Only run merchant-site jobs after noon Europe/Paris.
JOB_OFFPEAK_ONLY=0
BROWSER_CHROME_PATH=/usr/bin/google-chrome
BROWSER_PROFILE_DIR=/app/profile
BROWSER_DOWNLOADS_DIR=/app/data/downloads
